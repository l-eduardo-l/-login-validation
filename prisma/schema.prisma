// Arquivo que descreve o banco de dados.
// A URL de conexão NÃO fica mais aqui no Prisma 7: ela fica no prisma.config.ts.

generator client {
  provider = "prisma-client"
  // Onde o Prisma gera o código do client (no Prisma 7 o "output" é obrigatório).
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Cada "model" vira uma tabela no SQLite.
model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique   // não permite dois cadastros com o mesmo email
  usuario   String   @unique   // não permite dois cadastros com o mesmo nome de usuário
  senha     String             // aqui vai o HASH da senha, nunca a senha pura
  criadoEm  DateTime @default(now())
}
